<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Camera used ONLY as a substitute ambient-light sensor: one frame is
         captured on screen-on to read exposure parameters, then released.
         The M500 has no ALS. No image is stored or transmitted. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.M500Hardware">

        <!-- Main M500 Hardware & DAC Settings (Integrated into System Settings) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.M500Hardware">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.settings.SOUND_SETTINGS" />
                <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="com.android.settings.category.ia.sound" />
                <category android:name="com.android.settings.category.ia.homepage" />
                <category android:name="com.android.settings.category.ia.system" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.sound" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/hardware_settings_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/hardware_settings_summary" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-100" />
        </activity>

        <!-- Bespoke Verbose USB DAC Mode Activity -->
        <activity
            android:name=".UsbDacActivity"
            android:exported="true"
            android:label="M500 USB DAC"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.M500Hardware">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="com.m500.hardware.action.USB_DAC" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Pulsar RGB Lighting Settings Activity (Injected directly into Main Android Settings) -->
        <activity
            android:name=".PulsarDialogActivity"
            android:exported="true"
            android:label="Pulsar RGB Light"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.M500Hardware">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="com.m500.hardware.action.PULSAR_SETTINGS" />
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="com.android.settings.category.ia.display" />
                <category android:name="com.android.settings.category.ia.system" />
                <category android:name="com.android.settings.category.ia.sound" />
                <category android:name="com.android.settings.category.ia.homepage" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.title"
                android:value="Pulsar RGB Light" />
            <meta-data
                android:name="com.android.settings.summary"
                android:value="Audio format status, battery indication &amp; dynamic effects" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-257" />
        </activity>

        <!-- Fullscreen Cyber Pocket Lock HUD Overlay -->
        <activity
            android:name=".PocketHudActivity"
            android:exported="true"
            android:label="Pocket Lock HUD"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.M500Hardware.Translucent">
            <intent-filter>
                <action android:name="com.m500.hardware.action.SHOW_POCKET_HUD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Quick Settings Tiles -->
        <service
            android:name=".UsbDacTileService"
            android:label="USB DAC"
            android:icon="@android:drawable/ic_dialog_info"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".PocketLockTileService"
            android:label="Pocket Lock"
            android:icon="@android:drawable/ic_lock_lock"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".PulsarTileService"
            android:label="Pulsar RGB"
            android:icon="@android:drawable/ic_dialog_alert"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".AmbientBrightnessService"
            android:exported="false"
            android:description="@string/app_name" />

        <service
            android:name=".PocketLockService"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="System hardware key and touch lock barrier" />
        </service>

        <receiver
            android:name=".PulsarReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.m500.hardware.action.SET_PULSAR_MODE" />
                <action android:name="com.m500.hardware.action.SET_PULSAR_RGB" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".PocketLockReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="FN_BUTTON_STATE_CHANGE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
