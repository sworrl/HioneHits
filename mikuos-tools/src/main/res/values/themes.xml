<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="miku_bg">#FF06090B</color>

    <style name="Theme.MikuTools" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/miku_bg</item>
        <item name="android:colorBackground">@color/miku_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">#FF39C5BB</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Ring screen: no starting-window animation so a 7 am wake shows the buttons at once. -->
    <style name="Theme.MikuTools.Ring" parent="Theme.MikuTools">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">false</item>
    </style>
</resources>
