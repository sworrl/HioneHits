<?xml version="1.0" encoding="utf-8"?>
<!-- Miku Signal badge widget: Wi-Fi pod / seam / cellular pod, texts + colors set at render. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_signal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="@drawable/miku_badge_widget_bg"
    android:padding="6dp">

    <TextView
        android:id="@+id/widget_signal_wifi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WIFI ▮▮▮▯"
        android:textColor="#39C5BB"
        android:textSize="9sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_signal_seam"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:text="/"
        android:textColor="#5539C5BB"
        android:textSize="9sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_signal_cell"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LTE ▮▮▯▯"
        android:textColor="#9FF3EC"
        android:textSize="9sp"
        android:textStyle="bold"
        android:maxLines="1" />
</LinearLayout>
