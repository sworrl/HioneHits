<?xml version="1.0" encoding="utf-8"?>
<!-- Shared background for the Miku status-badge widgets. Rounded "pill" with the Miku teal→dark
     wash and a faint teal stroke, matching the in-launcher badge look. Material-ish: soft corners,
     subtle border. Reused by every badge widget so they read as one family at any size. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="14dp" />
    <gradient
        android:angle="0"
        android:startColor="#EE0EE7DD"
        android:centerColor="#F2103032"
        android:endColor="#F2091420" />
    <stroke android:width="1dp" android:color="#5539C5BB" />
</shape>
