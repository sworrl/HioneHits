<?xml version="1.0" encoding="utf-8"?>
<!-- Sized to the real Compact Cassette shell's own proportions (101.6mm x 63.5mm, ~1.6:1) rather
     than a generic wide-widget aspect — the whole point is that it reads as an actual cassette,
     not a rectangle with a cassette drawn inside it. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="240dp"
    android:minHeight="150dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen|keyguard"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_tape"
    android:initialKeyguardLayout="@layout/widget_tape"
    android:previewLayout="@layout/widget_tape"
    android:description="@string/app_name" />
