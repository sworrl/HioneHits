<?xml version="1.0" encoding="utf-8"?>
<!--
  MikuOS system bridge. The one MikuOS package that runs as the system UID, so it gets the
  system_app SELinux domain: HiBy's policy lets system_app set vendor_usb_prop, usb_control_prop
  and vendor_audio_prop, and lets platform_app (every other Miku app) set almost nothing.
  It has no UI and does exactly what the receivers below list, only for callers holding the
  signature permission, i.e. other apps signed with the platform key.
  It is persistent so the charge limit (ChargeLimiter) can follow the battery: the system starts
  it at boot and restarts it if it dies.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:sharedUserId="android.uid.system"
    tools:ignore="SharedUserId">

    <permission
        android:name="com.miku.permission.SYSTEM_BRIDGE"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.miku.permission.SYSTEM_BRIDGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- BootSeeds. The system uid passes these checks anyway, they are listed for readers. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.GRANT_RUNTIME_PERMISSIONS" />
    <uses-permission android:name="android.permission.MANAGE_APP_OPS_MODES" />
    <uses-permission android:name="android.permission.CHANGE_COMPONENT_ENABLED_STATE" />
    <uses-permission android:name="android.permission.CHANGE_OVERLAY_PACKAGES" />

    <application
        android:name=".BridgeApp"
        android:label="MikuOS system bridge"
        android:allowBackup="false"
        android:persistent="true">
        <receiver
            android:name=".BridgeReceiver"
            android:exported="true"
            android:permission="com.miku.permission.SYSTEM_BRIDGE">
            <intent-filter>
                <action android:name="com.miku.sysbridge.USB_DAC" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".AudioReceiver"
            android:exported="true"
            android:permission="com.miku.permission.SYSTEM_BRIDGE">
            <intent-filter>
                <action android:name="com.miku.sysbridge.AUDIO" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".HttpProxyReceiver"
            android:exported="true"
            android:permission="com.miku.permission.SYSTEM_BRIDGE">
            <intent-filter>
                <action android:name="com.miku.sysbridge.HTTP" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".BootSeedsReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
